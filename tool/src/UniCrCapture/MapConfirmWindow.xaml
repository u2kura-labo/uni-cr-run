<Window x:Class="UniCrCapture.MapConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="マップの確認" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Background="{StaticResource Page}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="22">
    <TextBlock Text="MAP" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
    <TextBlock x:Name="Question" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,10"/>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock x:Name="Summary" TextWrapping="Wrap"/>
        <TextBlock x:Name="Note" Foreground="{StaticResource Warning}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,6,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <TextBlock Text="違っていれば、ここで選び直してください" Foreground="{StaticResource Text2}" FontSize="12"/>
    <ComboBox x:Name="MapBox" Margin="0,4,0,14" Padding="6,4" FontSize="13"/>

    <CheckBox x:Name="DontAsk" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,16"
              Content="次からは確認しない（設定でまた出せます）"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="登録しない" Style="{StaticResource DarkButton}" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="これで登録" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
