<Window x:Class="UniCrCapture.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight" MaxWidth="380"
        FontFamily="{StaticResource UiFont}">
  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
          CornerRadius="10" Padding="12,10" Margin="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
    </Border.Effect>
    <DockPanel>
      <Border x:Name="Stripe" DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,2,10,2"/>
      <StackPanel>
        <TextBlock x:Name="TitleText" Foreground="{StaticResource Text}" FontWeight="Bold" FontSize="13"/>
        <ItemsControl x:Name="DetailList" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" Margin="0,1"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
