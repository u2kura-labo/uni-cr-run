<Window x:Class="UniCrCapture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflict Record Capture の設定" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource Page}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
  <StackPanel Margin="22">
    <TextBlock Text="SETTINGS" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
    <TextBlock Text="Conflict Record Capture の設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
    <TextBlock x:Name="Intro" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,0,0,14"
               Text="リザルト画面でボタン（またはホットキー）を押すと、FF14 の画面を撮って戦績を読み取り、保存フォルダの matches-日付.jsonl に追記します。"/>

    <TextBlock Text="自分のキャラクター名" FontWeight="SemiBold"/>
    <TextBlock Text="リザルト画面の表から自分の行を見つけるのに使います。" Foreground="{StaticResource Text2}" FontSize="12"/>
    <TextBox x:Name="SelfName" Margin="0,4,0,14"/>

    <TextBlock Text="保存フォルダ" FontWeight="SemiBold"/>
    <TextBlock Text="ここに matches-日付.jsonl と、撮った画像（captures フォルダ）を保存します。" Foreground="{StaticResource Text2}" FontSize="12"/>
    <DockPanel Margin="0,4,0,14">
      <Button DockPanel.Dock="Right" Content="選ぶ…" Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="OnBrowse"/>
      <TextBox x:Name="SaveFolder"/>
    </DockPanel>

    <TextBlock Text="ホットキー" FontWeight="SemiBold"/>
    <TextBlock Text="ボタンの代わりに押して撮れます（例：Ctrl+Shift+F12、Alt+F11）。" Foreground="{StaticResource Text2}" FontSize="12"/>
    <TextBox x:Name="HotkeyText" Margin="0,4,0,14"/>

    <TextBlock Text="名前の鍵" FontWeight="SemiBold"/>
    <TextBlock Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap"
               Text="他のプレイヤーの名前は、この鍵で暗号化して保存します。ファイルが人の手に渡っても名前は読めません。ビューアで名前を見るには、この鍵をビューアの「名前の鍵」に入れてください。鍵をなくすと、それまでの名前は戻せません。"/>
    <DockPanel Margin="0,6,0,4">
      <Button DockPanel.Dock="Right" Content="鍵のファイルを保存…" Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="OnSaveKey"/>
      <Button DockPanel.Dock="Right" Content="鍵をコピー" Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="OnCopyKey"/>
      <TextBlock x:Name="KeyIdText" VerticalAlignment="Center" FontFamily="Consolas"/>
    </DockPanel>
    <TextBlock x:Name="KeyStatus" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,0,0,14"/>

    <TextBlock Foreground="{StaticResource Text2}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
               Text="個人で使うためのツールです。他のプレイヤーの名前が入ったデータや、その画面のスクリーンショットを共有しないでください。作成したファイルには、あなたのキャラクター名と鍵の番号が入ります。"/>

    <CheckBox x:Name="KeepImages" Foreground="{StaticResource Text}" Margin="0,0,0,18"
              Content="撮った画像も保存する（読み取りを直したあとに読み直せます）"/>

    <TextBlock x:Name="Error" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

    <DockPanel>
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
        <Hyperlink Foreground="{StaticResource Accent}" Click="OnOpenViewer">ビューアを開く（Web）</Hyperlink>
      </TextBlock>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" Style="{StaticResource DarkButton}" Margin="0,0,8,0" IsCancel="True"/>
        <Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
